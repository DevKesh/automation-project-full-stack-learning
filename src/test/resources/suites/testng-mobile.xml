<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Android/Appium suite. thread-count=1 because a single physical device serves one session at a
     time; parallel mobile requires one device per thread, which is a device-farm concern, not a
     default. Run with: mvn test -Pmobile -->
<suite name="Android Mobile Suite" verbose="1" thread-count="1">

    <listeners>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
        <listener class-name="com.project.qa.testsupport.listeners.ScreenshotListener"/>
        <!-- Auto-attaches RetryAnalyzer to every @Test; retry.count in config controls attempts -->
        <listener class-name="com.project.qa.testsupport.listeners.RetryTransformer"/>
    </listeners>

    <groups>
        <run>
            <include name="mobile"/>
        </run>
    </groups>

    <test name="Android Mobile Web Tests">
        <classes>
            <class name="com.project.qa.tests.mobile.MobileWebSmokeTest"/>
        </classes>
    </test>

</suite>
