<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Myntra Android app suite. thread-count=1 (one physical device, one session). Native session,
     so no browser calls. Zero manual setup: the app is installed from the Play Store if missing,
     permissions are pre-granted, and the login wall is skipped. Run with:
       mvn test -Pmobile-myntra -->
<suite name="Myntra Android App Suite" verbose="1" thread-count="1">

    <listeners>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
        <listener class-name="com.project.qa.listeners.ScreenshotListener"/>
        <!-- Auto-attaches RetryAnalyzer to every @Test; retry.count in config controls attempts -->
        <listener class-name="com.project.qa.listeners.RetryTransformer"/>
    </listeners>

    <groups>
        <run>
            <include name="mobile"/>
        </run>
    </groups>

    <test name="Myntra Native App Tests">
        <classes>
            <class name="com.project.qa.tests.MyntraAppTest"/>
        </classes>
    </test>

</suite>
