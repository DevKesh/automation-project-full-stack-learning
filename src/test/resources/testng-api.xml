<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- API-only suite. The <groups><run><include> filter runs just the @Test methods tagged "api",
     so listing broader classes here would still execute only API tests. Browser-free REST Assured
     calls are stateless, so parallel="methods" is safe. Run with: mvn test -Papi -->
<suite name="API Suite" verbose="1" parallel="methods" thread-count="3">

    <listeners>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
        <listener class-name="com.project.qa.listeners.ScreenshotListener"/>
        <!-- Auto-attaches RetryAnalyzer to every @Test; retry.count in config controls attempts -->
        <listener class-name="com.project.qa.listeners.RetryTransformer"/>
    </listeners>

    <groups>
        <run>
            <include name="api"/>
        </run>
    </groups>

    <!-- Package scan, not a hand-maintained <class> list. The "api" group filter above decides
         membership: any @Test(groups = API) under this package auto-joins the suite. Adding an API
         test needs zero edits here. -->
    <test name="API Tests">
        <packages>
            <package name="com.project.qa.tests.api"/>
        </packages>
    </test>

</suite>
