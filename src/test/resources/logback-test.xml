<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <!-- Clean pattern: Timestamp, Level, Message -->
            <pattern>%d{dd:MM:yyyy HH:mm:ss} %-5level - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Set root level to INFO to filter out deep Selenium debug noise -->
    <root level="INFO">
        <appender-ref ref="CONSOLE" />
    </root>
</configuration>