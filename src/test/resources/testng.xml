<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Myntra Automation Suite" verbose="1">

    <listeners>
        <!-- This single line wires up Allure to your entire suite -->
        <listener class-name="io.qameta.allure.testng.AllureTestNg" />
    </listeners>

    <test name="Product Search Tests">
        <classes>
            <!-- Ensure this matches your exact package and class name -->
            <class name="com.project.qa.tests.SearchProductsTest"/>
        </classes>
    </test>

</suite>